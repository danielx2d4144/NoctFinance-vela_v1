# Noct Finance V1 — environment template
#
# Copy to `.env` and fill in. `.env` and `.env.*` are gitignored; THIS file is the
# whitelisted exception (.gitignore line 7) because it holds no secrets and no guesses.
#
# ⚠️ No script in this repo auto-loads this file — there is no `dotenv` dependency in
#    deploy-scripts/package.json or noct-demo-wasm/package.json. The deploy scripts read
#    `process.env.*` directly, so you must export these yourself, e.g.:
#      PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item "env:$($Matches[1].Trim())" $Matches[2].Trim() } }
#      bash:        set -a; . ./.env; set +a
#
# ── Provenance rule ─────────────────────────────────────────────────────────────
# Every value below is either ✅ VERIFIED (checked against the live chain, the Horizen
# reply of 2026-09-28, or an official registry) or ⬜ UNKNOWN (an open blocker).
# An UNKNOWN value is left EMPTY on purpose. Do not fill it in with a guess: the
# scripts fail closed on empty, which is the intended behaviour. A guessed address
# fails loudly at worst and silently at best — 14-DAY-ROADMAP.md Day 13 forbids it.
# Full evidence and verification method: VELA-TESTNET-CONSTANTS.md
# ───────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# VELA — Base Sepolia instance (our target)
# ══════════════════════════════════════════════════════════════════════════════

# ✅ VERIFIED — live RPC answered eth_chainId = 0x14a34
VELA_RPC_URL=https://sepolia.base.org
VELA_CHAIN_ID=84532

# ✅ VERIFIED (B1) — reply + eth_getCode (46,494 hex chars) + facilitator status page
VELA_PROCESSOR_ENDPOINT=0xd5E405a84753635608E7a28A59D7349BB2DAaEeF

# ✅ VERIFIED (B2) — reply + eth_getCode (7,396 hex chars)
VELA_TEE_AUTHENTICATOR=0x69Ca935A17e3920B80DB71d723Aee918e1aE75E3

# ✅ VERIFIED (B4, partial) — an HTTP *service* URL, NOT a contract address.
# ⚠️ Plaintext HTTP to a bare IP. Do not treat anything it returns as authenticated.
VELA_AUTHORITY_SERVICE_URL=http://34.246.94.215:8081

# ✅ VERIFIED — reply and status page agree
VELA_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cml7x1bnbintv01xu7tih85gl/subgraphs/vela-base-sepolia/0.2.0/gn

# ✅ VERIFIED — facilitator wallet and endpoints (see VELA-TESTNET-CONSTANTS.md §6)
VELA_FACILITATOR_WALLET=0xd028cC273cC9A512ed074C7139d813f002e52D06

# ⬜ BLOCKED (B11) — MUST stay empty. We have no application of our own: deployment is
# permissioned and only Horizen can deploy. This is assigned when OUR app is deployed and
# must then be read back from the chain, never transcribed once and trusted (File 31
# assertion 5).
# ⚠️ Do NOT substitute vela-nova's ID 11579806367557720661 — that is a different app.
# ⚠️ The value 2397975349340933566 that older scripts hardcoded is FABRICATED; it
#    matches no instance and was formally retracted in the root commit.
VELA_APPLICATION_ID=

# ✅ VERIFIED (B3) — self-derived from ProcessorEndpoint.tokenAllowlist(), then confirmed
# to hold 2,096 bytes of code. Not supplied by Horizen; we read it off the contract.
VELA_TOKEN_ALLOWLIST=0x8774E760B45a60a15B75770Fd7c60338006beEfa

# ✅ VERIFIED (B4) — self-derived from ProcessorEndpoint.authorityRegistry(), 1,124 bytes.
# A real contract DOES exist; the AuthorityServiceURL above is an HTTP service in front of
# it, not a substitute for it.
VELA_AUTHORITY_REGISTRY=0x754a26f68E3E4Fab1BD05FB6B227bedEC2e732d3

# ✅ VERIFIED — AccessControl role hashes read from the live ProcessorEndpoint (B11).
# DEPLOYER_ROLE is what a deploy sender must hold. Reset is a ROLE, not an address:
# the roadmap's old "is resetOperator non-zero?" question was based on a wrong premise.
VELA_ROLE_DEPLOYER=0xfc425f2263d0df187444b70e47283d622c70181c5baebb1306a01edba1ce184c
VELA_ROLE_RESET_OPERATOR=0xc580ee26c87bb95870d138607be6d8598a348af3608b6ce0cef58e73a4c95917

# ✅ VERIFIED — Horizen's deployer (from subgraph DeployRequestSubmitted.sender). Holds
# DEPLOYER_ROLE and RESET_OPERATOR but NOT DEFAULT_ADMIN_ROLE, so it cannot grant us
# anything: the B11 ask must go to whoever holds the admin key.
VELA_HORIZEN_DEPLOYER=0x2eaaf231ce583b7cd7ae02c03b8fe7a96f0aacb8


# ══════════════════════════════════════════════════════════════════════════════
# SECRETS — never commit these; `.env` is gitignored
# ══════════════════════════════════════════════════════════════════════════════

# Deployer / submitter key. Must be supplied at runtime.
# ⚠️ Even once set, deployment will fail until B11 is resolved: the sender needs
#    DEPLOYER_ROLE on the ProcessorEndpoint above.
VELA_DEPLOYER_PRIVATE_KEY=

# ✅ Required by Hermes; provision as a secret, never committed (File 31).
PYTH_API_KEY=


# ══════════════════════════════════════════════════════════════════════════════
# ASSETS — Base Sepolia
# ══════════════════════════════════════════════════════════════════════════════

# ✅ VERIFIED on-chain — decimals=6, symbol=USDC
NOCT_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
NOCT_USDC_DECIMALS=6

# ✅ VERIFIED on-chain — decimals=18
# ⛔ BLOCKED (B12): tZEN is NOT on the Vela TokenAllowlist. The subgraph's TokenAllowed
#    entities contain exactly one token, USDC. A tZEN deposit will fail until Horizen
#    allowlists it, so Day 6 must either be re-scoped to USDC-only or wait on B12.
NOCT_TZEN_ADDRESS=0x107fdE93838e3404934877935993782F977324BB
NOCT_TZEN_DECIMALS=18


# ══════════════════════════════════════════════════════════════════════════════
# ORACLE — Pyth
# ══════════════════════════════════════════════════════════════════════════════

# ⬜ BLOCKED (B7) — Pyth IPyth address on Base Sepolia is UNCONFIRMED. Prior candidates
# were found stale or invalid. Day 5 may only build against a local/mock adapter until
# this is answered; a mock adapter is NOT evidence of a live oracle.
NOCT_PYTH_ADDRESS=

# ✅ VERIFIED — present in Pyth's official registry
NOCT_PYTH_FEED_ETH_USD=0xff61491a931112ddf1bd8147cd1b641375f79f5825126d665480874634fd0ace
NOCT_PYTH_FEED_ZEN_USD=0xd183ffe0155e8a55e7274155a14ea2e8b54059cef471f88fa3f7eb4b5d8dbc24

# ⬜ BLOCKED (B10) — no USDC/USD feed ID obtained. File 31 assertion 4 requires exactly
# three verified feeds. DO NOT hardcode USDC = $1 to paper over this: that would make
# oracleCommitment a lie and would hide a depeg. Either obtain the feed ID or formally
# re-scope the three-feed requirement in writing.
NOCT_PYTH_FEED_USDC_USD=


# ══════════════════════════════════════════════════════════════════════════════
# REFERENCE ONLY — not configuration, do not use
# ══════════════════════════════════════════════════════════════════════════════
# Horizen L3 testnet is a SECOND, separate instance. We target Base Sepolia.
#   rpcUrl            https://horizen-testnet.rpc.caldera.xyz/http   (chainId 2652444)
#   Processor         0xD057f11f95e949Bf64C59EefD2bbe5465538D0c2
#   TeeAuthenticator  0xCb75dE475d7590E380abB04d3c94B51c95e77c12
#   AuthorityService  http://34.246.94.215:8181
#   vela-nova appID   17812598362091411873
# vela-nova's Base Sepolia appID is 11579806367557720661. Both are someone else's app.
